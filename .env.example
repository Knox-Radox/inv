# Copy to .env.local for local work. In production these are set in Vercel:
# Project Settings > Environment Variables.
#
# Only the first is public. Everything under "The RSVP" is a secret and must
# never be given the NEXT_PUBLIC_ prefix, which ships a value to the browser.

# The site's public URL, so the share card's image address is absolute.
NEXT_PUBLIC_SITE_URL=https://advikaandsooraj.vercel.app

# --- The RSVP: README.md § The RSVP -----------------------------------------

# Supabase dashboard > Integrations > Data API > "API URL".
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard > Settings > API Keys > "Secret keys" (starts sb_secret_).
# The SECRET key, not the publishable one: the publishable key can do nothing
# here by design. An older project's `service_role` key also works.
SUPABASE_SECRET_KEY=

# What the family types to open /replies. Six characters or more. Changing it
# signs everybody out.
REPLIES_PASSCODE=

# Any long random string. Vercel sends it with the daily keep-alive request.
CRON_SECRET=
